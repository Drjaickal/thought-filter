generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RewriteTone {
  CORPORATE
  PROFESSIONAL
  FRIENDLY
  EXECUTIVE
}

model User {
  id      String  @id @default(cuid())
  clerkId String  @unique
  email   String  @unique
  name    String?

  thoughts Thought[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Thought {
  id String @id @default(cuid())

  originalText String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  rewrites Rewrite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optimized for:
  // WHERE userId = ?
  // ORDER BY createdAt DESC
  @@index([userId, createdAt])
}

model Rewrite {
  id String @id @default(cuid())

  rewrittenText String

  tone RewriteTone

  intent   String?
  emotion  String?
  toxicity Float?
  audience String?

  model         String?
  promptVersion String?

  thoughtId String
  thought   Thought @relation(fields: [thoughtId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Optimized for:
  // WHERE thoughtId = ?
  // ORDER BY createdAt DESC
  @@index([thoughtId, createdAt])
}
